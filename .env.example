# Desenvolvimento local (Docker Compose). Nao use estes valores em homologacao/producao.
NODE_ENV=development

# PostgreSQL 16 no Docker de desenvolvimento. A VM do CP2b roda PostgreSQL 18.
POSTGRES_DB=arqueia
POSTGRES_USER=arqueia
POSTGRES_PASSWORD=arqueia_dev_only
POSTGRES_PORT=5432
# Hosts 'postgres'/'redis' sao os servicos do Docker Compose. Na VM, troque
# ambos por 127.0.0.1 — ver docs/deployment/VM-DEPLOYMENT.md.
DATABASE_URL=postgresql://arqueia:arqueia_dev_only@postgres:5432/arqueia

# Redis 7
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Aplicacoes
# Em producao nativa (VM sem Docker), use 127.0.0.1. No Docker local de desenvolvimento, 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=4001
WEB_PORT=4002
NEXT_PUBLIC_API_URL=http://localhost:4001
API_INTERNAL_URL=http://127.0.0.1:4001
PUBLIC_ORIGIN=http://localhost:4002
# Prefixo publico da implantacao. Vazio na raiz; /arqueia na VM do CP2b.
# Precisa ser identico no build e no runtime do PM2 — sem barra final.
NEXT_PUBLIC_BASE_PATH=

# Autenticacao local e politicas de seguranca. Gere um valor forte e exclusivo fora de dev.
JWT_SECRET=local-development-only-change-me
JWT_ACCESS_TTL_SECONDS=900
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
DEV_SEED_ADMIN_PASSWORD=change-this-dev-password

# Ganchos futuros de SSO/OIDC (deixe vazios no login local)
OIDC_ENABLED=false
OIDC_DISPLAY_NAME=Entrar com Unicamp
OIDC_AUTHORIZATION_URL=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Notificacoes (nao configuradas por padrao em dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=arqueia@example.invalid
