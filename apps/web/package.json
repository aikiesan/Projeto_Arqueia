{
  "name": "@arqueia/web",
  "version": "0.0.0",
  "private": true,
  "description": "PWA responsivo (Next.js) — operação mobile-first + gestão desktop-first.",
  "scripts": {
    "predev": "npm run build --workspace @arqueia/contracts",
    "dev": "next dev -p 4002",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "start": "next start -p 4002",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arqueia/contracts": "*",
    "@arqueia/ui": "*",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
