{
  "name": "@arqueia/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Fonte da verdade: tipos e schemas compartilhados (DTOs, validações) entre web, api e worker.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
